---
import AuthLayout from '../layouts/AuthLayout.astro';
import { apiBaseUrl } from '../lib/config';
---

<AuthLayout
	title="Sahkan E-mel - KasihBersama"
	description="Sahkan alamat e-mel akaun KasihBersama anda."
>
	<div id="state-loading" class="state" aria-live="polite">
		<div class="spinner" aria-hidden="true"></div>
		<p>Sedang mengesahkan e-mel anda&hellip;</p>
	</div>

	<div id="state-success" class="state" hidden aria-live="polite">
		<div class="icon icon-success" aria-hidden="true">✓</div>
		<h1>E-mel disahkan</h1>
		<p>Anda akan diarahkan ke halaman seterusnya&hellip;</p>
	</div>

	<div id="state-error" class="state" hidden aria-live="polite">
		<div class="icon icon-error" aria-hidden="true">!</div>
		<h1>Pautan tidak sah</h1>
		<p id="error-message">
			Pautan pengesahan ini tidak sah atau telah luput. Sila minta pautan
			baharu melalui aplikasi.
		</p>
		<a class="recovery-link" href="/contact">Hubungi kami sekiranya anda memerlukan bantuan</a>
	</div>
</AuthLayout>

<script is:inline define:vars={{ apiBaseUrl }}>
	const params = new URLSearchParams(window.location.search);
	const token = params.get('token');

	const loading = document.getElementById('state-loading');
	const success = document.getElementById('state-success');
	const errorState = document.getElementById('state-error');
	const errorMessage = document.getElementById('error-message');

	function show(el) {
		loading.hidden = true;
		success.hidden = true;
		errorState.hidden = true;
		el.hidden = false;
	}

	if (!token) {
		errorMessage.textContent =
			'Pautan ini tidak mengandungi token yang sah. Sila semak semula pautan dalam e-mel anda.';
		show(errorState);
	} else {
		fetch(`${apiBaseUrl}/api/v1/auth/verify-email`, {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ token }),
		})
			.then(async (res) => {
				if (res.ok) {
					window.location.href = '/email-verified';
					return;
				}
				const data = await res.json().catch(() => null);
				if (data?.error?.message) {
					errorMessage.textContent = data.error.message;
				}
				show(errorState);
			})
			.catch(() => {
				errorMessage.textContent =
					'Pelayan tidak dapat dihubungi. Sila cuba lagi sebentar lagi.';
				show(errorState);
			});
	}
</script>
