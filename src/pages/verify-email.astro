---
import AuthLayout from "../layouts/AuthLayout.astro";
import { apiBaseUrl } from "../lib/config";
---

<AuthLayout
	title="Sahkan Emel — KasihBersama"
	description="Sahkan alamat emel akaun KasihBersama anda."
>
	<div id="state-loading" class="state" aria-live="polite">
		<div class="spinner" aria-hidden="true"></div>
		<p>Mengesahkan emel anda&hellip;</p>
	</div>

	<div id="state-success" class="state" hidden aria-live="polite">
		<div class="icon icon-success" aria-hidden="true">✓</div>
		<h1>Emel disahkan</h1>
		<p>
			Mengarahkan anda ke halaman seterusnya&hellip;
		</p>
	</div>

	<div id="state-error" class="state" hidden aria-live="polite">
		<div class="icon icon-error" aria-hidden="true">!</div>
		<h1>Pautan tidak sah</h1>
		<p id="error-message">
			Pautan pengesahan ini tidak sah atau telah luput. Sila mohon pautan
			baharu dari aplikasi.
		</p>
	</div>
</AuthLayout>

<script is:inline define:vars={{ apiBaseUrl }}>
	const params = new URLSearchParams(window.location.search);
	const token = params.get("token");

	const loading = document.getElementById("state-loading");
	const success = document.getElementById("state-success");
	const errorState = document.getElementById("state-error");
	const errorMessage = document.getElementById("error-message");

	function show(el) {
		loading.hidden = true;
		success.hidden = true;
		errorState.hidden = true;
		el.hidden = false;
	}

	if (!token) {
		errorMessage.textContent =
			"Pautan ini tiada token yang sah. Sila semak semula pautan dalam emel anda.";
		show(errorState);
	} else {
		fetch(`${apiBaseUrl}/api/v1/auth/verify-email`, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({ token }),
		})
			.then(async (res) => {
				if (res.ok) {
					window.location.href = "/email-verified";
					return;
				}
				const data = await res.json().catch(() => null);
				if (data?.error?.message) {
					errorMessage.textContent = data.error.message;
				}
				show(errorState);
			})
			.catch(() => {
				errorMessage.textContent =
					"Tidak dapat menghubungi pelayan. Sila cuba lagi sebentar.";
				show(errorState);
			});
	}
</script>

<style>
	.state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	.spinner {
		width: 32px;
		height: 32px;
		border: 3px solid var(--color-primary-light);
		border-top-color: var(--color-primary);
		border-radius: 50%;
		animation: spin 0.8s linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22px;
		font-weight: 700;
	}

	.icon-success {
		background: var(--color-primary-light);
		color: var(--color-primary);
	}

	.icon-error {
		background: #fdecea;
		color: #b3261e;
	}

	h1 {
		font-size: 22px;
		font-weight: 700;
		margin: 0;
		color: var(--color-text-primary);
	}

	p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
	}
</style>
