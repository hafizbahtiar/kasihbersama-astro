---
import { Image } from 'astro:assets';
import AuthLayout from '../layouts/AuthLayout.astro';
import mark from '../assets/brand/mark-192.png';
import '../styles/pages.css';
---

<AuthLayout
	title="Emel Disahkan - KasihBersama"
	description="Emel anda telah berjaya disahkan."
>
	<div class="auth-success-state">
		<div class="icon" aria-hidden="true">
			<Image src={mark} alt="" width={46} height={42} />
		</div>
		<h1>Emel berjaya disahkan</h1>
		<p class="message">
			Akaun KasihBersama anda kini aktif sepenuhnya. Anda boleh mula
			menggunakan aplikasi untuk menyelaraskan penjagaan orang tersayang.
		</p>
		<a href="https://kasihbersama.com/" class="btn" id="open-app-btn">Buka aplikasi</a>
		<p class="fallback" id="fallback-text">
			Atau buka semula aplikasi KasihBersama yang sedia ada.
		</p>
	</div>
</AuthLayout>

<script>
	const btn = document.getElementById('open-app-btn');
	const fallback = document.getElementById('fallback-text');

	if (!btn || !fallback) {
		throw new Error('Elemen pautan aplikasi tidak dijumpai.');
	}

	btn.addEventListener('click', () => {
		let opened = false;
		const timer = setTimeout(() => {
			if (!opened) fallback.style.display = 'block';
		}, 2000);

		window.addEventListener('blur', () => {
			opened = true;
			clearTimeout(timer);
		}, { once: true });
	});
</script>
