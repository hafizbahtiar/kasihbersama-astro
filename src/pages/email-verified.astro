---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout
	title="Emel Disahkan — KasihBersama"
	description="Emel anda telah berjaya disahkan."
>
	<div class="state">
		<div class="icon icon-success" aria-hidden="true">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="20 6 9 17 4 12" />
			</svg>
		</div>
		<h1>Emel berjaya disahkan!</h1>
		<p class="message">
			Akaun KasihBersama anda kini aktif sepenuhnya. Anda boleh mula
			menggunakan aplikasi untuk menyelaraskan penjagaan orang tersayang.
		</p>
		<!-- Universal Link, not a custom scheme (project decided against kasihbersama:// —
		     see kasihbersama_flutter/TODO.md §1). Registration is blocked on the release
		     keystore + prod domain, so this may just load the site until that ships. -->
		<a href="https://kasihbersama.com/" class="btn" id="open-app-btn">
			Buka Aplikasi
		</a>
		<p class="fallback" id="fallback-text">
			Atau buka semula aplikasi KasihBersama yang sedia ada.
		</p>
	</div>
</AuthLayout>

<script>
	// Try to open the app via deep link
	const btn = document.getElementById("open-app-btn");
	const fallback = document.getElementById("fallback-text");

	btn.addEventListener("click", (e) => {
		// If the app doesn't open within 2s, show fallback instructions
		let opened = false;
		const timer = setTimeout(() => {
			if (!opened) {
				fallback.style.display = "block";
			}
		}, 2000);

		window.addEventListener("blur", () => {
			opened = true;
			clearTimeout(timer);
		});
	});
</script>

<style>
	.state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.icon {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: pop-in 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
	}

	.icon-success {
		background: var(--color-primary-light);
		color: var(--color-primary);
	}

	@keyframes pop-in {
		0% {
			transform: scale(0);
			opacity: 0;
		}
		100% {
			transform: scale(1);
			opacity: 1;
		}
	}

	h1 {
		font-size: 22px;
		font-weight: 700;
		margin: 0;
		color: var(--color-text-primary);
	}

	.message {
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
		max-width: 340px;
	}

	.btn {
		display: inline-block;
		margin-top: 8px;
		padding: 14px 32px;
		background: var(--color-primary);
		color: white;
		font-size: 15px;
		font-weight: 600;
		font-family: inherit;
		border: none;
		border-radius: 999px;
		text-decoration: none;
		cursor: pointer;
		transition: background 0.2s;
	}

	.btn:hover {
		background: #005248;
	}

	.btn:active {
		transform: scale(0.97);
	}

	.fallback {
		font-size: 13px;
		color: var(--color-text-secondary);
		margin: 0;
		display: none;
	}
</style>
