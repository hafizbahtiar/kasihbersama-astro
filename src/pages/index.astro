---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import mark from '../assets/brand/mark-512.png';
import '../styles/landing.css';

const features = [
	{
		number: '01',
		title: 'Bulatan penjagaan',
		description:
			'Jemput ahli keluarga untuk berkongsi tanggungjawab menjaga orang tersayang dalam satu ruang yang sama.',
	},
	{
		number: '02',
		title: 'Log penjagaan',
		description:
			'Rekod aktiviti harian seperti makan, tidur dan mood supaya semua ahli keluarga sentiasa memahami keadaan terkini.',
	},
	{
		number: '03',
		title: 'Ubat dan peringatan',
		description:
			'Jejak jadual ubat dan tandakan dos yang telah diambil tanpa bergantung pada mesej atau nota yang berasingan.',
	},
	{
		number: '04',
		title: 'Temujanji dan dokumen',
		description:
			'Simpan temujanji perubatan dan dokumen penting di satu tempat yang mudah dicapai oleh keluarga.',
	},
];

const trustPoints = ['Data disulitkan', 'Patuh PDPA Malaysia', 'Tiada jualan data'];
---

<SiteLayout>
	<main>
		<section class="hero">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Penjagaan keluarga, bersama</p>
					<h1>Kongsikan penjagaan dengan lebih tenang.</h1>
					<p class="subtitle">
						KasihBersama membantu keluarga menyelaraskan log harian, ubat,
						temujanji dan dokumen orang tersayang dalam satu tempat.
					</p>
					<p class="availability">Akan datang di App Store dan Google Play</p>
				</div>
				<div class="hero-mark" aria-hidden="true">
					<Image src={mark} alt="" width={360} height={332} priority />
				</div>
			</div>
		</section>

		<section class="proof-row" aria-label="Komitmen KasihBersama">
			{trustPoints.map((point) => <span>{point}</span>)}
		</section>

		<section class="features" id="ciri-ciri" aria-labelledby="features-title">
			<div class="section-heading">
				<p class="eyebrow">Satu ruang untuk perkara yang penting</p>
				<h2 id="features-title">Dibina untuk rutin penjagaan sebenar.</h2>
			</div>
			<div class="feature-list">
				{features.map((feature) => (
					<article class="feature-item">
						<span class="feature-number" aria-hidden="true">{feature.number}</span>
						<div>
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>
	</main>
</SiteLayout>
