---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import mark from '../assets/brand/mark-512.png';
import '../styles/landing.css';

const features = [
	{
		number: '01',
		title: 'Ruang Bersama',
		description:
			'Himpunkan ahli keluarga dalam satu ruang, agihkan peranan dan kongsi maklumat yang perlu diketahui bersama.',
	},
	{
		number: '02',
		title: 'Rutin dan tugasan',
		description:
			'Urus perkara yang perlu dibuat, siapa yang bertanggungjawab dan apa yang sudah selesai.',
	},
	{
		number: '03',
		title: 'Rekod penjagaan',
		description:
			'Simpan apa yang berlaku setiap hari, daripada rutin keluarga hingga penjagaan orang tersayang.',
	},
	{
		number: '04',
		title: 'Dokumen dan peringatan',
		description:
			'Simpan dokumen penting, tarikh luput dan perkara berulang di tempat yang mudah dicapai.',
	},
];

const trustPoints = ['Satu ruang untuk keluarga', 'Akses berasaskan peranan', 'Data disulitkan'];
---

<SiteLayout>
	<main>
		<section class="hero">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Pengurusan keluarga, bersama</p>
					<h1>Urusan keluarga, tersusun dalam satu ruang.</h1>
					<p class="subtitle">
						KasihBersama membantu keluarga mengurus Ruang Bersama, rutin,
						tugasan, dokumen dan penjagaan orang tersayang dengan lebih jelas.
					</p>
					<p class="availability">Akan tersedia di App Store dan Google Play</p>
				</div>
				<div class="hero-mark" aria-hidden="true">
					<Image src={mark} alt="" width={360} height={332} priority />
				</div>
			</div>
		</section>

		<section class="proof-row" aria-label="Prinsip KasihBersama">
			{trustPoints.map((point) => <span>{point}</span>)}
		</section>

		<section class="features" id="ciri-ciri" aria-labelledby="features-title">
			<div class="section-heading">
				<p class="eyebrow">Daripada rutin harian hingga urusan penting</p>
				<h2 id="features-title">Satu gambaran yang boleh dikongsi oleh seluruh keluarga.</h2>
			</div>
			<div class="feature-list">
				{features.map((feature) => (
					<article class="feature-item">
						<span class="feature-number" aria-hidden="true">{feature.number}</span>
						<div>
							<h3>{feature.title}</h3>
							<p>{feature.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="roadmap" aria-labelledby="roadmap-title">
			<div class="roadmap-inner">
				<div>
					<p class="eyebrow">Dibina untuk kehidupan sebenar</p>
					<h2 id="roadmap-title">Satu keluarga, banyak perkara yang perlu diingat.</h2>
				</div>
				<p>
					Apabila KasihBersama berkembang, ruang yang sama akan membantu keluarga
					mengurus kenderaan, kewangan rumah, sekolah, dokumen penting dan
					perancangan masa depan.
				</p>
			</div>
		</section>
	</main>
</SiteLayout>
