---
import AuthLayout from '../layouts/AuthLayout.astro';
import { apiBaseUrl } from '../lib/config';
---

<AuthLayout
	title="Tetapkan Semula Kata Laluan - KasihBersama"
	description="Tetapkan semula kata laluan akaun KasihBersama anda."
>
	<div id="state-form" class="state" hidden>
		<h1>Tetapkan kata laluan baharu</h1>
		<p class="hint">Sekurang-kurangnya 10 aksara.</p>
		<form id="reset-form">
			<label for="password">Kata laluan baharu</label>
			<input
				type="password"
				id="password"
				name="password"
				minlength="10"
				required
				autocomplete="new-password"
			/>

			<label for="confirm">Sahkan kata laluan</label>
			<input
				type="password"
				id="confirm"
				name="confirm"
				minlength="10"
				required
				autocomplete="new-password"
			/>

			<p id="form-error" class="form-error" hidden aria-live="polite"></p>

			<button type="submit" id="submit-btn">Tetapkan kata laluan</button>
		</form>
	</div>

	<div id="state-success" class="state" hidden aria-live="polite">
		<div class="icon icon-success" aria-hidden="true">✓</div>
		<h1>Kata laluan dikemaskini</h1>
		<p>Anda telah log keluar dari semua peranti. Log masuk semula dalam aplikasi dengan kata laluan baharu.</p>
	</div>

	<div id="state-error" class="state" hidden aria-live="polite">
		<div class="icon icon-error" aria-hidden="true">!</div>
		<h1>Pautan tidak sah</h1>
		<p id="error-message">
			Pautan tetapan semula ini tidak sah atau telah luput. Sila mohon pautan baharu dari aplikasi.
		</p>
	</div>
</AuthLayout>

<script define:vars={{ apiBaseUrl }}>
	const params = new URLSearchParams(window.location.search);
	const token = params.get('token');

	const formState = document.getElementById('state-form');
	const successState = document.getElementById('state-success');
	const errorState = document.getElementById('state-error');
	const errorMessage = document.getElementById('error-message');
	const form = document.getElementById('reset-form');
	const formError = document.getElementById('form-error');
	const submitBtn = document.getElementById('submit-btn');

	function show(el) {
		formState.hidden = true;
		successState.hidden = true;
		errorState.hidden = true;
		el.hidden = false;
	}

	if (!token) {
		errorMessage.textContent =
			'Pautan ini tiada token yang sah. Sila semak semula pautan dalam emel anda.';
		show(errorState);
	} else {
		show(formState);
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		formError.hidden = true;

		const password = document.getElementById('password').value;
		const confirm = document.getElementById('confirm').value;

		if (password.length < 10) {
			formError.textContent = 'Kata laluan mesti sekurang-kurangnya 10 aksara.';
			formError.hidden = false;
			return;
		}
		if (password !== confirm) {
			formError.textContent = 'Kata laluan tidak sepadan.';
			formError.hidden = false;
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = 'Menghantar...';

		try {
			const res = await fetch(`${apiBaseUrl}/api/v1/auth/reset-password`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ token, new_password: password }),
			});

			if (res.ok) {
				show(successState);
				return;
			}

			const data = await res.json().catch(() => null);

			if (res.status === 401) {
				errorMessage.textContent = data?.error?.message ?? 'Pautan ini tidak sah atau telah luput.';
				show(errorState);
				return;
			}

			formError.textContent = data?.error?.message ?? 'Tidak dapat menetapkan kata laluan. Sila cuba lagi.';
			formError.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = 'Tetapkan kata laluan';
		} catch (err) {
			formError.textContent = 'Tidak dapat menghubungi pelayan. Sila cuba lagi sebentar.';
			formError.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = 'Tetapkan kata laluan';
		}
	});
</script>

<style>
	.state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
	}

	h1 {
		font-size: 22px;
		font-weight: 700;
		margin: 0;
		color: var(--color-text-primary);
	}

	p {
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.hint {
		font-size: 13px;
	}

	form {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 6px;
		text-align: left;
		margin-top: 12px;
	}

	label {
		font-size: 13px;
		font-weight: 600;
		color: var(--color-text-primary);
		margin-top: 10px;
	}

	label:first-of-type {
		margin-top: 0;
	}

	input {
		padding: 10px 14px;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		font-size: 15px;
		font-family: inherit;
	}

	input:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}

	.form-error {
		color: #b3261e;
		font-size: 13px;
		margin: 4px 0 0;
	}

	button {
		margin-top: 16px;
		padding: 12px 20px;
		border: none;
		border-radius: 999px;
		background: var(--color-primary);
		color: white;
		font-size: 15px;
		font-weight: 600;
		font-family: inherit;
		cursor: pointer;
	}

	button:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.icon {
		width: 48px;
		height: 48px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 22px;
		font-weight: 700;
	}

	.icon-success {
		background: var(--color-primary-light);
		color: var(--color-primary);
	}

	.icon-error {
		background: #fdecea;
		color: #b3261e;
	}
</style>
