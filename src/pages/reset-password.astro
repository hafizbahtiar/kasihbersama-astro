---
import AuthLayout from '../layouts/AuthLayout.astro';
import { apiBaseUrl } from '../lib/config';
---

<AuthLayout
	title="Tetapkan Semula Kata Laluan - KasihBersama"
	description="Tetapkan semula kata laluan akaun KasihBersama anda."
>
	<div id="state-form" class="state">
		<h1>Tetapkan kata laluan baharu</h1>
		<p class="hint" id="password-hint">Kata laluan mestilah mengandungi sekurang-kurangnya 10 aksara.</p>
		<form id="reset-form">
			<label for="password">Kata laluan baharu</label>
			<input
				type="password"
				id="password"
				name="password"
				aria-describedby="password-hint form-error"
				minlength="10"
				required
				autocomplete="new-password"
			/>

			<label for="confirm">Sahkan kata laluan</label>
			<input
				type="password"
				id="confirm"
				name="confirm"
				aria-describedby="form-error"
				minlength="10"
				required
				autocomplete="new-password"
			/>

			<p id="form-error" class="form-error" hidden aria-live="polite" role="alert"></p>

			<button type="submit" id="submit-btn">Tetapkan kata laluan</button>
		</form>
	</div>

	<noscript>
		<p class="noscript-message">Sila aktifkan JavaScript untuk menetapkan semula kata laluan melalui pautan ini.</p>
	</noscript>

	<div id="state-success" class="state" hidden aria-live="polite">
		<div class="icon icon-success" aria-hidden="true">✓</div>
		<h1>Kata laluan telah dikemas kini</h1>
		<p>Anda telah dilog keluar daripada semua peranti. Sila log masuk semula ke dalam aplikasi menggunakan kata laluan baharu.</p>
	</div>

	<div id="state-error" class="state" hidden aria-live="polite">
		<div class="icon icon-error" aria-hidden="true">!</div>
		<h1>Pautan tidak sah</h1>
		<p id="error-message">
			Pautan penetapan semula ini tidak sah atau telah luput. Sila minta pautan baharu melalui aplikasi.
		</p>
		<a class="recovery-link" href="/contact">Hubungi kami sekiranya anda memerlukan bantuan</a>
	</div>
</AuthLayout>

<script define:vars={{ apiBaseUrl }}>
	const params = new URLSearchParams(window.location.search);
	const token = params.get('token');

	const formState = document.getElementById('state-form');
	const successState = document.getElementById('state-success');
	const errorState = document.getElementById('state-error');
	const errorMessage = document.getElementById('error-message');
	const form = document.getElementById('reset-form');
	const formError = document.getElementById('form-error');
	const submitBtn = document.getElementById('submit-btn');

	function show(el) {
		formState.hidden = true;
		successState.hidden = true;
		errorState.hidden = true;
		el.hidden = false;
	}

	if (!token) {
		errorMessage.textContent =
			'Pautan ini tidak mengandungi token yang sah. Sila semak semula pautan dalam e-mel anda.';
		show(errorState);
	} else {
		show(formState);
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		formError.hidden = true;

		const password = document.getElementById('password').value;
		const confirm = document.getElementById('confirm').value;

		if (password.length < 10) {
			formError.textContent = 'Kata laluan mesti sekurang-kurangnya 10 aksara.';
			formError.hidden = false;
			return;
		}
		if (password !== confirm) {
			formError.textContent = 'Kata laluan tidak sepadan.';
			formError.hidden = false;
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = 'Menghantar…';

		try {
			const res = await fetch(`${apiBaseUrl}/api/v1/auth/reset-password`, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ token, new_password: password }),
			});

			if (res.ok) {
				show(successState);
				return;
			}

			const data = await res.json().catch(() => null);

			if (res.status === 401) {
				errorMessage.textContent = data?.error?.message ?? 'Pautan ini tidak sah atau telah luput. Sila minta pautan baharu melalui aplikasi.';
				show(errorState);
				return;
			}

			formError.textContent = data?.error?.message ?? 'Kata laluan tidak dapat ditetapkan. Sila cuba lagi.';
			formError.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = 'Tetapkan kata laluan';
		} catch (err) {
			formError.textContent = 'Pelayan tidak dapat dihubungi. Sila cuba lagi sebentar lagi.';
			formError.hidden = false;
			submitBtn.disabled = false;
			submitBtn.textContent = 'Tetapkan kata laluan';
		}
	});
</script>
