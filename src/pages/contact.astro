---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Hubungi Kami - KasihBersama" description="Hubungi pasukan KasihBersama.">
	<main class="prose-page">
		<article class="prose">
			<h1>Hubungi Kami</h1>
			<p>
				Ada soalan, maklum balas, atau nak laporkan isu privasi? Kami
				sedia membantu.
			</p>
			<a class="contact-email" href="mailto:hafiz@hafizbahtiar.com">hafiz@hafizbahtiar.com</a>
			<p class="note">Kami akan cuba membalas secepat mungkin.</p>
		</article>
	</main>
</SiteLayout>

<style>
	.prose-page {
		padding-top: 56px;
		padding-bottom: 72px;
	}

	.prose {
		text-align: center;
	}

	.prose h1 {
		margin-bottom: 16px;
	}

	.prose p {
		margin-bottom: 24px;
	}

	.contact-email {
		display: inline-flex;
		align-items: center;
		max-width: 100%;
		min-height: 48px;
		font-size: 20px;
		font-weight: 600;
		color: var(--color-primary);
		background: var(--color-primary-light);
		border-radius: 999px;
		padding: 12px 24px;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.note {
		margin-top: 20px !important;
		font-size: 13px !important;
	}
</style>
