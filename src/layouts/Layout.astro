---
import { apiBaseUrl, mode } from '../lib/config';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'KasihBersama - Pengurusan keluarga, bersama',
	description = 'KasihBersama membantu keluarga mengurus circle, rutin, tugasan, dokumen dan penjagaan orang tersayang dalam satu ruang.',
} = Astro.props;
---

<!doctype html>
<html lang="ms">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/brand/mark-96.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="theme-color" content="#0f5b5d" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="kb-build" content={`mode=${mode} api=${apiBaseUrl}`} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<slot />
	</body>
</html>
